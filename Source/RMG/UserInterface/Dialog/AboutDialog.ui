<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AboutDialog</class>

 <widget class="QDialog" name="AboutDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>720</width>
    <height>420</height>
   </rect>
  </property>

  <property name="windowTitle">
   <string>About Mupen MPN</string>
  </property>

  <layout class="QVBoxLayout" name="mainLayout">

   <!-- TABS -->
   <item>
    <widget class="QTabWidget" name="tabWidget">

     <!-- ================= ABOUT TAB ================= -->
     <widget class="QWidget" name="tabAbout">
      <attribute name="title">
       <string>About</string>
      </attribute>

      <layout class="QHBoxLayout" name="aboutLayout">

       <!-- LOGO -->
       <item>
        <widget class="QLabel" name="logoLabel">
         <property name="minimumSize">
          <size><width>160</width><height>160</height></size>
         </property>
         <property name="maximumSize">
          <size><width>160</width><height>160</height></size>
         </property>
         <property name="pixmap">
          <pixmap resource="../UIResources.qrc">:/Resource/RMG.png</pixmap>
         </property>
         <property name="alignment">
          <set>Qt::AlignCenter</set>
         </property>
         <property name="scaledContents">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <!-- RIGHT PANEL -->
       <item>
        <layout class="QVBoxLayout" name="infoLayout">

         <!-- TITLE -->
         <item>
          <widget class="QLabel" name="titleLabel">
           <property name="text">
            <string>Mupen MPN</string>
           </property>
           <property name="styleSheet">
            <string notr="true">
font-size:26px;
font-weight:bold;
            </string>
           </property>
          </widget>
         </item>

         <!-- VERSION (C++ injected git hash) -->
         <item>
          <widget class="QLabel" name="versionLabel">
           <property name="text">
            <string>git: loading...</string>
           </property>
           <property name="styleSheet">
            <string notr="true">
color:#888;
font-size:13px;
            </string>
           </property>
          </widget>
         </item>

         <!-- SPACER (proper Qt spacing instead of CSS hacks) -->
         <item>
          <spacer name="headerSpacer">
           <property name="orientation">
            <enum>Qt::Vertical</enum>
           </property>
           <property name="sizeHint">
            <size>
             <width>0</width>
             <height>12</height>
            </size>
           </property>
          </spacer>
         </item>

         <!-- DESCRIPTION -->
         <item>
          <widget class="QLabel" name="descLabel">
           <property name="text">
            <string>Mupen MPN is a free and open-source Nintendo 64 emulator.

This software should only be used with games you legally own.</string>
           </property>

           <property name="wordWrap">
            <bool>true</bool>
           </property>

           <property name="styleSheet">
            <string notr="true">
color:#ddd;
font-size:12px;
            </string>
           </property>
          </widget>
         </item>

         <!-- LEGACY -->
         <item>
          <widget class="QLabel" name="legacyLabel">
           <property name="text">
            <string>Legacy of Jeff "FunnyBirdMan":
This project carries forward the vision he believed in.
We continue it in his honor by making Nintendo 64 netplay accessible to everyone,
removing barriers, and focusing on ease of use and mod support for the community.

Although he can no longer be with us, we hope he can see that he was cared about,
and that his vision continues to live on through this project.</string>
           </property>

           <property name="wordWrap">
            <bool>true</bool>
           </property>

           <property name="styleSheet">
            <string notr="true">
color:#bbb;
font-size:11px;
            </string>
           </property>
          </widget>
         </item>

        </layout>
       </item>

      </layout>
     </widget>

     <!-- ================= CONTRIBUTORS TAB ================= -->
     <widget class="QWidget" name="tabContributors">
      <attribute name="title">
       <string>Contributors</string>
      </attribute>

      <layout class="QVBoxLayout" name="contributorsLayout">

       <item>
        <widget class="QTextEdit" name="contributorsText">
         <property name="readOnly">
          <bool>true</bool>
         </property>

         <property name="plainText">
          <string>
Core Contributors:
- Rosalie — RMG Developer
- Logan — Simple64 Netcode Developer
- mupen64plus Team

MPN Contributors:
- Tabitha — Mupen MPN Developer
- Lave, Jeff₍₁₎ — MPN Founders
- Rain, gamemasterplc, zestydev — decompilation project contributors
- Airsolan — Cheat System
- gamemasterplc — Cheat System

And everyone who contributed, tested, and supports the project.

₍₁₎ In memory of Jeff, an early contributor who shaped the project’s foundation, community direction, and emulator vision. His historic contributions will always be remembered.
          </string>
         </property>

        </widget>
       </item>

      </layout>
     </widget>

     <!-- ================= LICENSE TAB ================= -->
     <widget class="QWidget" name="tabLicense">
      <attribute name="title">
       <string>License</string>
      </attribute>

      <layout class="QVBoxLayout" name="licenseLayout">

       <item>
        <widget class="QTextEdit" name="licenseText">
         <property name="readOnly">
          <bool>true</bool>
         </property>

         <property name="plainText">
          <string>
GNU GENERAL PUBLIC LICENSE
Version 3

This program is free software: you can redistribute it and/or modify it
under the terms of the GNU General Public License.

This program is distributed WITHOUT ANY WARRANTY.
          </string>
         </property>

        </widget>
       </item>

      </layout>
     </widget>

    </widget>
   </item>

   <!-- COPYRIGHT -->
   <item>
    <widget class="QLabel" name="copyrightLabel">
     <property name="text">
      <string>© Mario Party Netplay — Built on Mupen64Plus / RMG foundation</string>
     </property>
     <property name="alignment">
      <set>Qt::AlignCenter</set>
     </property>
     <property name="styleSheet">
      <string notr="true">
color:#777;
font-size:11px;
      </string>
     </property>
    </widget>
   </item>

  </layout>
 </widget>

 <connections/>
</ui>